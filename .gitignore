# Pipeline outputs - written here by the notebooks, regenerated on every run
Merged_long_files/
Tabulations/
Charts/
Logs/

# Timestamped backups written by update_dictionary() and add_source_translations()
translation dict_V2 backup *.xlsx
source translations_V2 backup *.xlsx

# Excel lock files, created while a workbook is open
~$*.xlsx
~$*.xls
